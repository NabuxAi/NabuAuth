{
    "name": "nabux/nabu-auth",
    "type": "project",
    "description": "NabuAuth Central Single Sign-On and OAuth2 Identity Server",
    "keywords": ["nabuauth", "sso", "oauth2", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0",
        "laravel/sanctum": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
